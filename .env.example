# Server Configuration
PORT=3000
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/complaint_management?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/complaint_management
# When running without an external MongoDB server, the built-in resilient in-memory database engine activates automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/complaint_management

# JWT Secret for authenticating REST API requests
JWT_SECRET=super_secret_enterprise_jwt_key_2026_complaint_desk
JWT_EXPIRES_IN=7d

# App URL for hosting
APP_URL="MY_APP_URL"
